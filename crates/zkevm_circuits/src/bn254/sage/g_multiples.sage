# BN254 base field
p = 21888242871839275222246405745257275088696311157297823662689037894645226208583
Fp = GF(p)

# BN254 scalar field
q = 21888242871839275222246405745257275088548364400416034343698204186575808495617
Fq = GF(q)

a = Fp(0)
b = Fp(3)
E = EllipticCurve(Fp, (a, b))
G = E(1, 2)  # Generator
E.set_order(q)

multiplicator = 2 ** 72

result = G * multiplicator

x, y = result.xy()
print("x =", int(x)) # 20947751279411573967585707957796076884838306892329084570991215098141587145326
print("y =", int(y)) # 10881143085651043635655119061072151249898091434241810000875579880240699672420